# shellcheck shell=bash
# scripts/herdrvs -- source this from your bash/zsh config:
#
#     source /path/to/herdr-plugins/scripts/herdrvs
#
# Defines `herdrvs`: create Herdr Spaces from the .code-workspace file in the current
# directory. All arguments are passed straight through to the plugin's `bin/adopt`, so
# `herdrvs --dry-run`, `herdrvs --file x.code-workspace` and `herdrvs --relabel` work.
#
# This is a locator and nothing else -- every decision (path resolution, deduping
# against live Spaces, the sync/adopt mutual-exclusivity guard) lives in
# vscode-workspace-sync/src/adopt.py, which already has the JSONC parser and the Herdr
# snapshot reader. Reimplementing any of it in shell would mean two things to keep
# in step.

herdrvs() {
    local root
    root="${HERDR_VSCODE_SYNC_ROOT:-}"

    if [ -z "$root" ]; then
        if ! command -v herdr >/dev/null 2>&1; then
            echo "herdrvs: herdr is not on PATH, and \$HERDR_VSCODE_SYNC_ROOT is unset." >&2
            return 127
        fi
        # python3, not jq: macOS ships the former and not the latter, and the plugin
        # already requires it. Same lookup the plugin README documents for --doctor.
        root=$(herdr plugin list --json 2>/dev/null | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
for p in doc.get("result", {}).get("plugins", []):
    if p.get("plugin_id") == "vscode-workspace-sync":
        print(p.get("plugin_root", ""))
        break
' 2>/dev/null)
    fi

    if [ -z "$root" ] || [ ! -x "$root/bin/adopt" ]; then
        echo "herdrvs: cannot find the vscode-workspace-sync plugin." >&2
        echo "  Link it:  herdr plugin link /path/to/herdr-plugins/vscode-workspace-sync" >&2
        echo "  Or set:   export HERDR_VSCODE_SYNC_ROOT=/path/to/vscode-workspace-sync" >&2
        return 127
    fi

    "$root/bin/adopt" "$@"
}
